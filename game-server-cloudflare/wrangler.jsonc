{
  "name": "cloud-weasel-game-server",
  "account_id": "528badc1c29c30196335df252a73c5a6",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_MATCHES",
        "class_name": "GameMatch"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameMatch"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://opensky-webapp.dysinski-tomasz.workers.dev,http://127.0.0.1:8787,http://localhost:8787",
    "PUBLIC_WS_BASE_URL": "wss://opensky-webapp.dysinski-tomasz.workers.dev/api/game/matches",
    "RELEASE_VERSION": "cloud-weasel-dev",
    "TURN_EXPIRY_MS": "60000",
    "TURN_EXTENSION_MS": "5000",
    "COMMIT_REVEAL_EXPIRY_MS": "2000",
    "ABANDON_TIMEOUT_MS": "180000",
    "BOT_ACTION_DELAY_MS": "650"
  }
}
