{
  "name": "cloud-weasel-game-server-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-15",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_MATCHES",
        "class_name": "GameMatch"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameMatch"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://opensky.example",
    "PUBLIC_WS_BASE_URL": "wss://opensky.example/api/game/matches",
    "INTERNAL_AUTH_SECRET": "game-server-test-secret",
    "MATCH_OWNER_PRIVATE_KEY": "1111111111111111111111111111111111111111111111111111111111111111",
    "RELEASE_VERSION": "test-release",
    "TURN_EXPIRY_MS": "60000",
    "TURN_EXTENSION_MS": "5000",
    "COMMIT_REVEAL_EXPIRY_MS": "2000",
    "ABANDON_TIMEOUT_MS": "180000"
  }
}
