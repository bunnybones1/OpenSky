{
  "name": "opensky",
  "private": true,
  "packageManager": "pnpm@8.15.7+sha256.50783dd0fa303852de2dd1557cd4b9f07cb5b018154a6e76d0f40635d6cee019",
  "engines": {
    "node": ">=16",
    "pnpm": ">=7"
  },
  "scripts": {
    "bootstrap": "pnpm clean && pnpm install",
    "build:cloudflare": "node ./utils/build-cloudflare.mjs",
    "dist": "pnpm -r dist",
    "watch": "pnpm -r watch",
    "test": "pnpm -r --no-bail exec tsc -p . --noEmit",
    "clean": "pnpm dlx rimraf node_modules ./**/node_modules",
    "audit:fix": "pnpm dlx pnpm-audit-fix",
    "typecheck": "pnpm -r --no-bail exec tsc -p . --noEmit",
    "preview:cloudflare": "pnpm build:cloudflare && pnpm --dir cloudflare exec wrangler dev --config ../wrangler.jsonc",
    "deploy:cloudflare": "pnpm build:cloudflare && pnpm --dir cloudflare exec wrangler deploy --config ../wrangler.jsonc",
    "provision:cloudflare:multiplayer-secrets": "node ./utils/provision-cloudflare-multiplayer-secrets.mjs",
    "test:cloudflare": "pnpm --filter @opensky/cloudflare test",
    "typecheck:cloudflare": "pnpm --filter @opensky/cloudflare typecheck",
    "db:migrate:cloudflare:local": "pnpm --dir cloudflare exec wrangler d1 migrations apply opensky-auth --local --config ../wrangler.jsonc"
  },
  "devDependencies": {
    "dpdm": "^3.10.0",
    "tslib": "2.4.0",
    "tsup": "^7.2.0",
    "typescript": "^5.1.6"
  },
  "resolutions": {
    "trim-newlines": "^3.0.1",
    "minimist": "^0.2.1",
    "sha3": "^2.0.0",
    "@npmcli/git": "^2.0.8",
    "ansi-regex": "^5.0.1",
    "axios": "^0.21.2"
  },
  "version": "0.0.0",
  "pnpm": {
    "overrides": {
      "tsx": "3.12.1",
      "@types/react": "18.0.21",
      "@types/react-dom": "18.0.6",
      "smob": "1.4.1",
      "workbox-build": "7.3.0"
    },
    "patchedDependencies": {
      "@types/three@0.133.1": "patches/@types__three@0.133.1.patch",
      "three-bmfont-text@3.0.1": "patches/three-bmfont-text@3.0.1.patch",
      "three@0.133.1": "patches/three@0.133.1.patch",
      "through@2.3.8": "patches/through@2.3.8.patch",
      "word-wrapper@1.0.7": "patches/word-wrapper@1.0.7.patch"
    }
  }
}
