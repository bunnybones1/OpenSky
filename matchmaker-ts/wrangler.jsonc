{
  "name": "cloud-weasel-matchmaker",
  "account_id": "528badc1c29c30196335df252a73c5a6",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHMAKER_POOLS",
        "class_name": "MatchmakerPool"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchmakerPool"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://opensky-webapp.dysinski-tomasz.workers.dev,http://127.0.0.1:8787,http://localhost:8787",
    "MATCH_ACCEPTANCE_TIMEOUT_MS": "30000",
    "MATCH_TICK_MS": "2000",
    "RELAX_MATCHING_INTERVAL_MS": "30000",
    "ENABLE_RANKED_BOTS": "false",
    "ALLOW_SAME_IP_MATCH": "false",
    "STRICT_CONQUEST_MATCHING": "false"
  }
}
