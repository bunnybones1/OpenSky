{
  "name": "cloud-weasel-game-analytics-test",
  "main": "src/cloudflareWorker.ts",
  "compatibility_date": "2026-07-15",
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "opensky-auth-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../cloudflare/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GAME_ANALYTICS",
      "bucket_name": "cloud-weasel-game-analytics-test"
    }
  ],
  "vars": {
    "ANALYTICS_RELEASE_VERSION": "test-release"
  }
}
