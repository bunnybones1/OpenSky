#[derive(EnumIter, Debug, Eq, PartialEq, Copy, Clone, Hash)]
pub enum BaseCard {
    Dummy, Hero, {{enumeration}}
}

#[cfg_attr(feature = "bindings", wasm_bindgen(typescript_custom_section))]
#[cfg(feature = "bindings")]
const TS_BASE_CARD: &str = r#"
export type BaseCard = "Dummy" | "Hero" {{ts_enumeration}}
"#;

impl serde::ser::Serialize for BaseCard {
    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
        where S: serde::ser::Serializer
    {
        serializer.serialize_str(match *self {
            BaseCard::Dummy => "Dummy",
            BaseCard::Hero => "Hero",
            {{serialize_enumeration}}
        })
    }
}

impl<'de> serde::de::Deserialize<'de> for BaseCard {
    fn deserialize<D>(deserializer: D) -> Result<Self, D::Error>
        where D: serde::de::Deserializer<'de>
    {
        let s = String::deserialize(deserializer)?;
        Ok(match s.as_str() {
            "Dummy" => BaseCard::Dummy,
            "Hero" => BaseCard::Hero,
            {{deserialize_enumeration}}
            _ => return Err(serde::de::Error::custom("Enum variant not found"))
        })
    }
}


#[derive(Deserialize, Serialize, Clone, Copy, Debug, PartialEq)]
#[cfg_attr(feature = "bindings", derive(TypescriptDefinition))]
pub enum CardEffect {
  // Use the effect generated by intrinsic_effect!()
  Intrinsic(BaseCard),
  {{card_effect_enum_members}}
}

impl CardEffect {
  pub fn effect(&self) -> &'static Effect {
    match self {
      Self::Intrinsic(base) => base.intrinsic_effect(),
      {{card_effect_enum_mappings}}
    }
  }
  pub fn source_card(&self) -> BaseCard {
    match self {
        Self::Intrinsic(base) => *base,
        {{card_effect_source_mappings}}
    }
  }
}



mod base_card {
    use super::*;
    use lazy_static::lazy_static;
    {{consts}}
    lazy_static! {
        pub static ref DUMMY: CardAttributes = CardAttributes {
            element: Element::Air,
            ..Default::default()
        };
        pub static ref HERO: CardAttributes = CardAttributes {
            r#type: Type::Hero,
            power: 1.into(),
            health: 32.into(),
            effects: vec![CardEffect::Intrinsic(BaseCard::Hero)],
            ..Default::default()
        };
    }
}

const NO_EFFECT: Effect = Effect::None;
impl BaseCard {
    pub fn instance(self) -> &'static CardAttributes {
        match self {
            BaseCard::Dummy => &*base_card::DUMMY,
            BaseCard::Hero => &*base_card::HERO,
            {{instances}}
        }
    }
    pub fn attached_spell(self) -> Option<BaseCard> {
        match self {
            BaseCard::Dummy | BaseCard::Hero => None,
            {{attached_spells}}
        }
    }

    pub fn intrinsic_effect(self) -> &'static Effect {
        match self {
            BaseCard::Dummy => &NO_EFFECT,
            BaseCard::Hero => &*card_effects::hero::EFFECT,
            {{effects}}
            _ => &NO_EFFECT
        }
    }
    pub fn season(self) -> u16 {
        match self {
            BaseCard::Dummy => 0,
            BaseCard::Hero => 0,
            {{seasons}}
        }
    }
}


impl TryFrom<u32> for BaseCard {
    type Error = ();
    fn try_from(number: u32) -> Result<Self, Self::Error> {
        match number {
            30999 => Ok(BaseCard::Dummy),
            {{try_from}}
            _ => Err(())
        }
    }
}

impl From<BaseCard> for u32 {
    fn from(card: BaseCard) -> u32 {
        match card {
            BaseCard::Dummy => 30999,
            BaseCard::Hero => 30998,
            {{to_u32}}
        }
    }
}

