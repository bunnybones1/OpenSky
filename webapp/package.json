{
  "name": "@opensky/webapp",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "start": "pnpm dev",
    "cors": "npx cors-anywhere",
    "dev": "RELEASE_VERSION=dev vite",
    "start:storybook": "storybook dev",
    "dev:https": "VITE_HTTPS=true pnpm dev",
    "dev:edge": "DIST=dev pnpm dev",
    "dev:stg": "DIST=stg pnpm dev",
    "dev:localassets": "DIST=localassets pnpm dev",
    "dist": "pnpm dist:clean && pnpm dist:build",
    "dist:build": "vite build",
    "dist:clean": "rm -rf ./dist",
    "dist:client": "serve -l 3000 ./dist",
    "dist:stats": "serve -l 5555 ./dist/.stats",
    "type-check": "tsc --skipLibCheck --noEmit",
    "lint": "eslint -c .eslintrc ./stories ./src --ext .ts,.tsx",
    "lint:fix": "eslint -c .eslintrc ./stories ./src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "fix": "pnpm lint:fix && pnpm format",
    "find-deadcode": "ts-prune",
    "test": "echo 'no tests!'",
    "preview": "vite preview",
    "link-sequence": "pnpm link 0xsequence @0xsequence/abi @0xsequence/api @0xsequence/auth @0xsequence/config @0xsequence/guard @0xsequence/indexer @0xsequence/metadata @0xsequence/multicall @0xsequence/network @0xsequence/provider @0xsequence/relayer @0xsequence/transactions @0xsequence/utils @0xsequence/wallet",
