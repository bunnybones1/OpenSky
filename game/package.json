{
  "name": "@opensky/game",
  "version": "0.3.0",
  "private": true,
  "description": "SKYWEAVER!!",
  "repository": "https://github.com/horizon-games/OpenSky",
  "keywords": [
    "opensky",
    "arcadeum",
    "dgame",
    "ethereum",
    "horizongames"
  ],
  "scripts": {
    "start": "pnpm dev",
    "dev": "RELEASE_VERSION=dev vite",
    "dist": "pnpm dist:clean && pnpm dist:build",
    "dist:build": "vite build && pnpm dist:create-state-mapping",
    "dist:clean": "rm -rf ./dist",
    "dist:client": "serve -l 3001 ./dist",
    "dist:stats": "serve -l 5555 ./dist/.stats",
    "dist:create-state-mapping": "node create-state-mapping.js",
    "lint": "pnpm run lint:unused-exports && pnpm tsc --noEmit --skipLibCheck && pnpm run lint:eslint && pnpm run bail-if-import-loops",
    "lint:fix": "pnpm tsc --noEmit --skipLibCheck && pnpm run lint:eslint:fix",
    "lint:unused-exports": "./node_modules/.bin/ts-unused-exports tsconfig.json --excludePathsFromReport='src/vendor;src/utils/arrayUtils.ts;src/utils/asyncUtils.ts;src/utils/localStorage.ts;src/utils/transformUtils.ts;src/crowdin.ts;src/tests'",
    "lint:unused-exports:fix": "pnpm run --silent lint:unused-exports --showLineNumber | awk '(NR>1)' | sed -E 's/(.+)\\[([[:digit:]]+),[[:digit:]]+\\]: .+/sed -i \"\\2s\\/^export \\/\\/\" \\1/g' | sh",
    "lint:eslint": "eslint ./src --ext .ts,.tsx --max-warnings=0",
    "lint:eslint:fix": "eslint ./src --ext .ts,.tsx --fix",
    "preview": "vite preview",
    "winlint": "pnpm run lint:unused-exports && pnpm run lint:eslint",
    "winlint:fix": "pnpm run lint:eslint:fix",
    "test:watch": "jest --watchAll",
    "test:watch:verbose": "jest --watchAll --verbose false",
    "test": "jest --ci --runInBand --passWithNoTests",
    "coverage": "jest --coverage",
    "show-loops": "echo 'digraph G {' > loop.dot && pnpm --quiet dlx dpdm -T ./src/index.ts | grep -e '->' | sed -r 's/[[:digit:]]+)//g' | sed -r 's/([^-]*) -> (.*)/\\1 -> \\2 -> \\1/g' | sed -r 's:/:__:g' | sed -r 's/\\.ts//g' | sed -r 's/\\.\\./____/g' | sed -r 's/-[^>]/_/g' >> loop.dot && echo '}' >> loop.dot && echo 'view loops in ./loop.dot'",
    "bail-if-import-loops": "pnpm dpdm --exit-code circular:1 -T ./src/index.ts"
  },
  "dependencies": {
    "@crowdin/crowdin-api-client": "^1.21.1",
    "@opensky/analytics": "workspace:*",
    "@opensky/bot": "workspace:*",
    "@opensky/deck-string-codec": "workspace:*",
    "@opensky/language-manager": "workspace:*",
    "@opensky/parse-card-description": "workspace:*",
    "@opensky/proto": "workspace:*",
    "@opensky/quests": "workspace:*",
    "@opensky/shared": "workspace:*",
    "@skyweaver/state-browser-sys": "workspace:*",
    "@skyweaver/state-metadata": "workspace:*",
    "@types/node": "^20.6.0",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "camel-case": "^4.1.1",
    "ethers": "^5.5.1",
    "gg": "horizon-games/gg#v0.7.8",
    "howler": "goldfire/howler.js#0323af9b843351cacc47893aed8e65cd8ba3b0cb",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-select-search": "^4.1.6",
    "simplex-noise": "^2.4.0",
    "snake-case": "^3.0.3",
    "three": "horizon-games/three.js#opensky-r133-sp2",
    "three-bmfont-text": "^3.0.1",
    "threejs-camera-controller-first-person-desktop": "^6.0.2"
  },
  "devDependencies": {
    "@sentry/cli": "^2.8.1",
    "@sentry/types": "^7.7.0",
    "@types/howler": "^2.2.1",
    "@types/jest": "28.1.4",
    "@types/three": "^0.133.1",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "@vitejs/plugin-react": "^4.0.4",
    "buffer": "^6.0.3",
    "concurrently": "^6.0.0",
    "dotenv": "^16.0.1",
    "dpdm": "^3.10.0",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^8.9.0",
    "eslint-define-config": "^1.15.0",
    "eslint-plugin-deprecation": "^1.5.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "jest": "29.6.4",
    "prettier": "^3.0.0",
    "rollup-plugin-visualizer": "^5.8.3",
    "serve": "^13.0.4",
    "ts-jest": "29.1.1",
    "ts-unused-exports": "^9.0.4",
    "typescript": "^5.1.6",
    "vite": "4.4.9",
    "vite-plugin-checker": "^0.6.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-glsl": "1.3.1",
    "vite-plugin-static-copy": "^0.17.0",
    "vite-plugin-top-level-await": "^1.3.0",
    "vite-plugin-wasm": "^3.2.1",
    "vite-tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/config/tests/browserMocks.js"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/config/tests/fileMock.js",
      "~(.*)$": "<rootDir>/src$1"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/build",
      "<rootDir>/dist"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(tsx?)$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/node_modules"
    ],
    "coverageReporters": [
      "json",
      "lcov",
      "text"
    ]
  },
  "browserslist": [
    "last 1 chrome versions"
  ]
}
