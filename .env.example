# Optional build and deployment metadata.
# Copy to `.env` for your own tooling or configure these values in CI.
# The repository scripts do not automatically load `.env` into your shell.

# Immutable path used for the browser-hosted game build.
RELEASE_VERSION=cloudflare

# Source revision embedded in the webapp. Defaults to RELEASE_VERSION when empty.
GITCOMMIT=

# Selects the Cloudflare account for non-interactive Wrangler commands.
CLOUDFLARE_ACCOUNT_ID=

# CI only. Local development can use `wrangler login` instead.
CLOUDFLARE_API_TOKEN=
