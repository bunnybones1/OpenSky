{
  "name": "@opensky/tools",
  "version": "1.0.0",
  "description": "shared tools for opensky packages",
  "private": true,
  "dependencies": {
    "csv-parser": "^3.0.0",
    "googleapis": "67"
  },
  "devDependencies": {
    "typescript": "^5.1.6"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./*": {
      "import": "./src/*.ts",
      "require": "./src/*.ts",
      "types": "./src/*.ts"
    }
  }
}
