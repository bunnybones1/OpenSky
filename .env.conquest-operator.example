# Read by your shell, not automatically by repository scripts. Copy to
# `.env.conquest-operator.local` (ignored by git), fill it, and export the
# values only for the operator command you are running.

# Deliberately has no production default; always name the exact target origin.
CLOUD_WEASEL_OPERATOR_URL=https://replace-with-reviewed-worker-origin.example

# The value of the `opensky_identity_session` cookie only, without the cookie
# name. Treat it as a short-lived secret and never commit or paste it into an
# operation JSON file.
CLOUD_WEASEL_OPERATOR_SESSION=replace-with-current-staff-session-token
