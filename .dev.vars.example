# Cloudflare Worker runtime values for local `wrangler dev`.
# Copy this file to `.dev.vars`. Never commit the populated file.

# Generate a random value with at least 32 characters.
SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters

# Google Auth Platform OAuth client with application type "Web application".
GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-web-client-secret

# Shared only by the web/API gateway, matchmaker, match service, and game service.
INTERNAL_AUTH_SECRET=replace-with-a-long-random-value

# Optional Cloud Weasel social integrations. Keep the Twitch client secret in
# Wrangler secrets in production. The Discord value is the full HTTPS widget
# JSON endpoint for the Cloud Weasel server; do not reuse the source server ID.
DISCORD_WIDGET_URL=https://discord.com/api/guilds/replace-with-server-id/widget.json
TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret
TWITCH_GAME_ID=replace-with-cloud-weasel-game-id

# Optional Stripe Checkout integration. Checkout remains disabled unless both
# secrets, both redirect URLs, and the selected product's price ID are set.
# Keep secret values in Wrangler secrets; price IDs and redirect URLs may be
# configured as environment variables.
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
STRIPE_SKYPASS_PRICE_ID=replace-with-stripe-skypass-price-id
STRIPE_CONQUEST_TICKET_PRICE_ID=replace-with-stripe-ticket-price-id
STRIPE_SUCCESS_URL=http://localhost:8787/skypass
STRIPE_CANCEL_URL=http://localhost:8787/skypass/purchase
