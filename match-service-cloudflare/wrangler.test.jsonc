{
  "name": "cloud-weasel-match-service-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-15",
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "opensky-auth-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../cloudflare/migrations"
    }
  ],
  "vars": {
    "INTERNAL_AUTH_SECRET": "match-service-test-secret",
    "CURRENT_SEASON": "126",
    "TURN_TIMER_ENABLED": "true"
  }
}
