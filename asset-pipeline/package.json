{
  "name": "@opensky/asset-pipeline",
  "version": "1.0.0",
  "description": "A tool that turns art into assets. All compression, conversion, copying, optimization, transcoding and validation should be done here.",
  "main": "index.js",
  "scripts": {
    "type-check": "tsc --skipLibCheck --noEmit",
    "build": "echo \"HI :D Please run 'pnpm start' instead\n\"",
    "lint": "pnpm run lint:unused-exports && pnpm run lint:eslint && pnpm run lint:prettier",
    "lint:fix": "pnpm run lint:eslint:fix && pnpm run lint:prettier:fix",
    "lint:unused-exports": "pnpm run ts-unused-exports tsconfig.json",
    "lint:eslint": "eslint ./src --ext .ts",
    "lint:eslint:fix": "eslint ./src --ext .ts --fix",
    "lint:prettier": "prettier --check --config ./.prettierrc $(find src '(' -name *.ts -o -name *.tsx ')' ! -path 'src/vendor/*')",
    "lint:prettier:fix": "prettier --config ./.prettierrc --write $(find src '(' -name *.ts -o -name *.tsx ')' ! -path 'src/vendor/*')",
    "typecheck": "tsc -p . --noEmit",
    "start": "pnpm run typecheck && tsx ./src/index.ts",
    "prod": "pnpm run start --log-level 3",
    "debug": "pnpm run start --log-level 9",
    "stats": "pnpm run typecheck && tsx ./src/stats.ts",
    "update-manifests": "./update-manifests.sh",
    "postinstall": "node -e \"process.platform != 'win32' && process.exit(1)\" || ./nixos-fixup.sh",
    "copy-released-art": "tsx ./src/copy-released-cards.ts"
  },
  "author": "Tomasz Dysinski <oz@bunnybones.com>",
  "private": true,
  "homepage": "https://github.com/horizon-games/OpenSky#readme",
  "dependencies": {
    "@arilotter/texture-compressor": "^1.0.5",
    "@opensky/design-data": "workspace:*",
    "@opensky/language-manager": "workspace:*",
    "@opensky/parse-card-description": "workspace:*",
    "@opensky/proto": "workspace:*",
    "@opensky/shared": "workspace:*",
    "@skyweaver/state-metadata": "workspace:*",
    "@types/cors": "^2.8.12",
    "audiosprite": "^0.7.2",
    "base64url": "^3.0.1",
    "blessed": "^0.1.81",
    "chalk": "^2.4.2",
    "cheerio": "^1.0.0-rc.3",
    "clone": "^2.1.2",
    "commander": "^9.4.1",
    "cors": "^2.8.4",
    "express": "^4.17.19",
    "glob": "^7.1.6",
    "gltfpack": "^0.16.0",
    "imagemagick": "^0.1.3",
    "listr": "^0.14.3",
    "md5-file": "^4.0.0",
    "msdf-bmfont-xml": "arilotter/msdf-bmfont-xml#v10",
    "puppeteer": "^20.2.1",
    "readline-sync": "^1.4.10",
    "say": "^0.16.0",
    "string-argv": "^0.3.1",
    "svgson": "^4.0.0",
    "write-file-atomic": "^5.0.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^3.4.8",
    "@types/blessed": "^0.1.17",
    "@types/cheerio": "^0.22.16",
    "@types/express": "^4.17.13",
    "@types/glob": "^7.1.1",
    "@types/imagemagick": "^0.0.30",
    "@types/md5-file": "^4.0.1",
    "@types/node": "^20.6.3",
    "@types/papaparse": "^4.5.9",
    "@types/write-file-atomic": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^8.9.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "papaparse": "^5.3.0",
    "prettier": "^3.0.0",
    "tsx": "^3.11.0",
    "typescript": "^5.1.6",
    "vite": "^4.4.8"
  },
  "pnpm": {
    "patchedDependencies": {
      "opentype.js@1.3.4": "patches/opentype.js@1.3.4.patch"
    }
  }
}
