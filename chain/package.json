{
  "name": "@opensky/chain",
  "version": "0.5.0",
  "private": true,
  "main": "adapter/index.js",
  "types": "adapter/index.d.ts",
  "scripts": {
    "build": "rimraf typings && hardhat clean && pnpm compile && pnpm adapter",
    "compile": "hardhat --max-memory 4096 compile",
    "adapter": "pnpm adapter:gen && pnpm adapter:build",
    "adapter:gen": "rimraf cache/typechain && typechain --target ethers-v5 --out-dir cache/typechain './artifacts/contracts/**/*[^dbg].json'",
    "adapter:build": "rimraf adapter && tsc -p ./tsconfig.adapter.json",
    "deploy": "tsx ./scripts/deploy-single-chain.ts"
  },
  "dependencies": {
    "@0xsequence/erc-1155": "3.1.1",
    "@0xsequence/erc20-meta-token": "3.2.0",
    "@0xsequence/niftyswap": "5.1.0",
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/bytes": "^5.0.0",
    "@ethersproject/providers": "^5.7.2",
    "@horizongames/skyweaver-contracts": "5.6.7-republished",
    "@opensky/chain-model": "workspace:*",
    "@opensky/shared": "workspace:*",
    "ethers": "^5.7.2",
    "tenderly": "^0.0.2"
  },
  "devDependencies": {
    "@0xsequence/deployer": "0.0.0-20221124173317",
    "@0xsequence/network": "^0.42.9",
    "@0xsequence/payment-proxy": "^0.1.1",
    "@0xsequence/relayer": "^0.42.9",
    "@0xsequence/utils": "^0.41.0",
    "@0xsequence/wallet": "^0.42.9",
    "@nomiclabs/hardhat-ethers": "^2.0.2",
    "@tenderly/hardhat-tenderly": "1.3.0",
    "@typechain/ethers-v5": "^10.1.1",
    "@types/chai": "^4.2.15",
    "@types/lodash": "^4.14.168",
    "@types/mocha": "^8.2.1",
    "@types/node": "^20.6.3",
    "chai": "^4.3.4",
    "dotenv": "^16.0.1",
    "hardhat": "2.12.2",
    "hardhat-gas-reporter": "1.0.9",
    "inquirer": "^7.0.0",
    "lodash": "^4.17.21",
    "ora": "^5.3.0",
    "rimraf": "^3.0.0",
    "tsx": "^3.11.0",
    "typechain": "^8.1.1",
    "typescript": "^5.1.6"
  }
}
