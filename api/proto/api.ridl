##
##
##

service SkyWeaverAPI

  #
  # Auth
  #

  - GetAuthToken(ethAuthProofString: string) => (status: bool, jwtToken: string, address: string, account?: Account)
  - GetSession() => (address: string, account?: Account)

  # Account migration for legacy accounts
  - MigrateAccount(req: MigrateAccountRequest) => (ok: bool)

  #
  # Account and user controls
  #
  - RegisterAccount(accountRegistration: AccountRegistration, captcha: string) => (status: bool, account: Account)
  - GetAccount(address: string) => (account: Account)
  - GetAccountByUsername(username: string) => (account: Account)
  - GetAccountStats(address: string, seasons?: []uint16) => (constructedStats: []AccountStat, discoveryStats: []AccountStat)
  - InternalGetAccountStats(address: string, seasons?: []uint16) => (constructedStats: []AccountStat, discoveryStats: []AccountStat)
  - AccountExists(address: string) => (exists: bool, pending_migration: bool)
  - AccountExistsByName(name: string) => (exists: bool, pending_migration: bool)
  - UpdateAccount(account: Account) => (account: Account)
  - RequestAccountDeletion(proof: WalletProof) => (status: bool)
  - RequestMoreInvites() => (status: bool)
  - SetInvitedBy(req: SetInvitedByRequest) => (ok: bool)
  - GetPrivateSpectateCode(reset?: bool) => (code: string)
  - ListNotifications() => (notifications: []Notification)
  - SetNotificationsAsSeen(notificationIDs: []uint64) => (status: bool)
  - MigrateFromBurner(ethAuthProofString: string) => (status: bool)
  - PrepareTransferAssetsFromBurnerTransaction() => (transactions: []OnChainTransaction)

  #
  # FriendPoints
  #
  - GetFriendPoints(address: string) => (total: uint64, friends: []FriendPoints)
  - GetPointsGifted(address: string) => (total: uint64, inviter: Account)

  #
  # Stickers
  #
  - GetStickers() => (stickers: []Sticker)
  - GetStickersBySeason(season: uint16) => (stickers: []Sticker)
  - GetStickerOwnership(accountAddress?: string) => (res: StickerOwnershipResponse)

  #
  # User Storage
  #
  - UserStorageFetch(key: string) => (object: any)
  - UserStorageSave(key: string, object: any) => (ok: bool)
  - UserStorageDelete(key: string) => (ok: bool)
  - UserStorageFetchAll(keys?: []string) => (objects: map<string, any>)
  #- UserStorageQuery(key: string, query: string) => (object: any)


  # Feed
  - GetFeed(page?: Page, req: GetFeedRequest) => (page?: Page, res: []FeedEvent)


  #
  # Items
  #
  - GetItemSummary(accountAddress: string, contractQuery?: bool) => (summary: map<string,ItemSummary>)
  - GetItemSupply(tokenID: uint64) => (summary: map<string,Item>)
  - GetBatchItemSupply(tokenIDs: []uint64) => (summary: map<uint64,map<string,Item>>)
  - GetItemSuppliesByType(itemTypes: []ItemType) => (summary: map<uint,[]ItemSupply>)
  - GetItemOwnershipByType(accountAddress?: string, itemTypes?: []ItemType) => (items: []Item)
  - MarkItemsNotNew(tokenIDs: []uint64, immediately?: bool) => (ok: bool)
  - EquipItem(itemType: ItemType, tokenID: uint64) => (item: Item)
  - UnequipItem(itemType: ItemType, tokenID: uint64) => (ok: bool)
  - ListEquippedItems(itemType?: ItemType) => (items: []Item)
  - GetDeckEquipmentByDeckString(accountAddress?: string, deckString: string) => (deckEquipment: DeckEquipment)

  #
  # Cards
  #

  # query the library in-memory index, these methods are super fast
  - GetCardLibrary(page?: Page) => (cards: []Card)
  - GetCardsByID(cardIDs: []uint64) => (cards: []Card)
  - GetCardsByDeckString(deckString: string) => (cards: []Card)

  # query the library and also include the player's balances
  - SearchCards(page?: Page, req: SearchCardsRequest) => (page?: Page, res: []CardWithBalance)

  - GetCardOwnership(accountAddress?: string, contractQuery?: bool) => (res: CardOwnershipResponse)
  - GetPendingCards() => (res: []PendingCardsResponse)

  #
  # Decks
  #
  - ListDecks(page?: Page) => (page?: Page, res: []Deck)
  - SearchDecks(page?: Page, req: SearchDecksRequest) => (page?: Page, res: []Deck)
  - CreateDeck(req: CreateDeckRequest) => (res: Deck)
  - UpdateDeck(req: UpdateDeckRequest) => (res: Deck)
  - FavoriteDeck(uuid: string) => (ok: bool)
  - UnfavoriteDeck(uuid: string) => (ok: bool)
  - ToggleDeckFavorite(uuid: string) => (isFavorite: bool)
  - GetDeck(req: DeckRequest) => (res: Deck)
  - CheckDeck(req: CheckDeckRequest) => (res: CheckDeckResponse)
  - DeleteDeck(req: DeckRequest) => (ok: bool)
  - SearchDeckRanks(page?: Page, req: SearchDeckRanksRequest) => (page?: Page, res: []DeckRank)
  - ListDeckRanks(page?: Page, req: ListDeckRanksRequest) => (page?: Page, res: []DeckRankAccount)
  - MarkDeckNotNew(uuid: string) => (ok: bool)
  - ListUnlockedDeckClasses() => (deckClass: []DeckClass)
  - GMResetStarterDecks(address: string) => (ok: bool)
  - InternalListUnlockedDeckStrings(req: InternalListUnlockedDeckStringsRequest) => (deckString: []string)

  #
  # Matches
  #
  - ListLeaderboard(page?: Page, req: ListLeaderboardRequest) => (page?: Page, res: []LeaderboardEntry)
  - ListMatches(page?: Page, req: ListMatchesRequest) => (page?: Page, res: []Match)
  - GetMatch(matchID: uint64) => (match: Match)
  - GetCurrentSeason() => (res: uint16)
  - GetNextRewardsTime() => (res: string)
  - GetNextSeasonTime() => (res: string)
  - GetCurrentSeasonStartTime() => (res: string)
  - AccountLeaderboard(page?: Page, req: AccountLeaderboardRequest) => (page?: Page, res: []LeaderboardEntry)

  - GetMatchArchiveRecordsURI(matchID: uint64, replayID: string) => (ok: bool, match?: Match, archiveIndexURI: string, recordURIs: []string)
  - GetMatchLiveRecordsURI(matchID: uint64) => (ok: bool, match?: Match, liveIndexURI: string)

  - BotMatchEnd(req: BotMatchEndRequest) => (rewards: []Reward)

  # admin-only / service-only
  - InternalMatchStart(req: MatchStartRequest) => (matchID: uint64, replayID: string)
  - InternalMatchEnd(req: MatchEndRequest) => (rewards: []Reward)

  - InternalAppendMatchArchiveRecords(matchID: uint64, index: int64, jsonStringData: string) => (status: bool, uri: string)
  - InternalAppendMatchLiveRecords(matchID: uint64, index: int64, jsonStringData: string) => (status: bool, uri: string)
  - InternalConquestStatus(address: string) => (conquest: Conquest)
  - InternalGetAccount(address: string) => (account: Account)
  - InternalGetBotAccounts(req: InternalGetBotAccountsRequest) => (accounts: []Account)
  - InternalGetPrivateSpectateCode(address: string) => (code: string)


  #
  # Conquest
  #
  - EnterConquest(hero: Hero) => (status: bool)
  - ConquestStatus() => (conquest: Conquest)
  - ConquestStats() =>(stats: ConquestStats)
  - ConquestRewards() => (weeklyGolds: []WeeklyGolds)
  - ConquestPoints() => (points: uint64, nedeed: uint64)
  - ConquestV2Pool() => (pool: ConquestV2Pool)
  - ConquestV2Progress() => (progress: ConquestV2TreasureProgress)
