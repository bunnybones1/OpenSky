webrpc = v1

name = api
version = v0.3.0

import ../../lib/quests/sheet_imported/quests.ridl
  - QuestType
  - EpicType

message Version
  - webrpcVersion: string
  - schemaVersion: string
  - schemaHash: string
  - appVersion: string

message Authorization
  - jwt: string
    + go.field.name = JWT

message WalletProof
  - address: string
  - message: string
  - signature: string

message SignInRequest
  - proof: WalletProof
  - account?: Account

message SignInResponse
  - account: Account
  - authorization: Authorization


message IPAddressHistory
  - id: uint64
    + go.tag.db = id,omitempty
    + go.field.name = ID

  - accountID: uint64
    + go.tag.db = account_id
    + go.field.name = AccountID
    + go.field.type = AccountID
    + json = -

  - ipAddress: string
    + go.tag.db = ip_address
    + go.field.type = pgtype.Inet
    + go.field.name = IPAddress

  - createdAt: timestamp
    + go.tag.db = created_at,omitempty
    + go.field.name = CreatedAt
    + go.field.type = *time.Time


message UserAgentHistory
  - id: uint64
    + go.tag.db = id,omitempty
    + go.field.name = ID

  - accountID: uint64
    + go.tag.db = account_id
    + go.field.name = AccountID
    + go.field.type = AccountID
    + json = -

  - userAgent: string
    + go.tag.db = user_agent

  - createdAt: timestamp
    + go.tag.db = created_at,omitempty
    + go.field.name = CreatedAt
    + go.field.type = *time.Time


enum AccountStatus: uint16
  - ACTIVE
  - SUSPENDED
  - BANNED
  - VIP
  - FLAGGED
  - TO_DELETE
  - DELETED

message Account
  - id: uint64
    + go.tag.db = id,omitempty
    + go.field.name = ID
    + go.field.type = AccountID

  - address: string
    + go.tag.db = address,omitempty
    + go.field.type = Hash

  - name: string
    + go.tag.db = name

  - locale: string
    + go.tag.db = locale

  - createdAt: timestamp
    + go.tag.db = created_at,omitempty
    + go.field.name = CreatedAt
    + go.field.type = *time.Time

  - updatedAt: timestamp
    + go.tag.db = updated_at,omitempty
    + go.field.name = UpdatedAt
    + go.field.type = *time.Time

  - experience: uint64
    + go.tag.db = -

  - warmUps: uint8
    + go.tag.db = warm_ups,omitempty

  - level: uint16
    + go.tag.db = level,omitempty

  - seasonLevel: uint16
    + go.tag.db = -

  - levelUpXP: uint64
    + go.tag.db = -

  - stats?: AccountStats
    + go.tag.db = -

  - region?: string
    + go.tag.db = region
    + go.field.type = Region

  - tagArtID?: string
    + go.tag.db = tag_art_id

  - crystalID?: uint64
    + go.tag.db = -

  - titleID?: uint64
    + go.tag.db = -

  - settings?: AccountSettings
    + go.tag.db = -
    + go.field.type = *AccountSettingsWrapper

  - privateSettings?: AccountSettings
    + go.tag.db = settings,omitempty
    + go.field.type = *AccountSettingsWrapper
    + json = -

  - oldAddress?: string
    + go.tag.db = old_address,omitempty
    + go.field.type = Hash
    + json = -

  - admin: bool
    + go.tag.db = admin
    + json = -

  - status: AccountStatus
    + go.tag.db = status
    + go.field.type = AccountStatus
    + json = -

  - isBot: bool
    + go.tag.db = is_bot
    + json = -

  - lastIPAddress?: string
    + go.tag.db = last_ip_address
    + go.field.type = pgtype.Inet
    + json = -

  - lastUA?: string
    + go.tag.db = last_ua
    + json = -

  - cursor: string
    + go.tag.db = cursor,omitempty
    + json = -

  - invitedByID?: uint64
    + go.tag.db = invited_by,omitempty
    + go.field.type = AccountID
    + json = -

  - invitedBy?: string
    + go.field.type = Hash

  - isBurnerWallet?: bool

message AccountRegistration
  - address: string
    + go.field.type = Hash

  - name?: string

  - isBurnerWallet?: bool

  - invitedBy?: string
    + go.field.type = Hash

  - locale: string

  - tagArtID?: string

  - deviceProperties?: DeviceProperties
    + go.tag.db = -
    + go.field.type = DeviceProperties

  - registrationEvent?: string

message DeviceProperties
  - countryCode?: string
    + json = countryCode,omitempty

  - deviceID?: string
    + json = deviceID,omitempty

  - environmentDevice?: string
    + json = environmentDevice,omitempty

  - environmentOS?: string
    + json = environmentOS,omitempty

  - environmentProduct?: string
    + json = environmentProduct,omitempty

message AccountStats
  - rankedConstructed?: AccountStat
    + json = rankedConstructed,omitempty
  - rankedDiscovery?: AccountStat
    + json = rankedDiscovery,omitempty
  - conquestConstructed?: AccountStat
    + json = conquestConstructed,omitempty
  - conquestDiscovery?: AccountStat
    + json = conquestDiscovery,omitempty

message AccountSettings
  - hidePlayerNames?: bool
    + json = hidePlayerNames,omitempty
  - suspended?: bool
    + json = suspended,omitempty
  - requestMoreInvites?: bool
    + json = requestMoreInvites,omitempty
  - renameLockedUntil?: timestamp
    + json = renameLockedUntil,omitempty
  - starterDeckV2Migration?: bool
    + json = starterDeckV2Migration,omitempty
  - spectateCode?: string
    + json = spectateCode,omitempty
  - spectateCodeExpiresAt?: timestamp
    + json = spectateCodeExpiresAt,omitempty
  - twitchProfile?: string
    + json = twitchProfile,omitempty
  - registrationEvent?: string
    + json = registrationEvent,omitempty
  - titleID?: uint64
    + json = titleID,omitempty
  - burnerAddress?: string
    + json = burnerAddress,omitempty
    + go.field.type = Hash

message AccountStat
  - accountID: uint64
    + go.tag.db = account_id
    + go.field.name = AccountID
    + go.field.type = AccountID
    + json = -

  - gameMode: GameMode
    + go.field.type = GameMode
    + go.tag.db = game_mode

  - winCount: int32
    + go.field.name = WinCount
    + go.tag.db = win_count

  - lossCount: int32
    + go.field.name = LossCount
    + go.tag.db = loss_count

  - tieCount: int32
    + go.field.name = TieCount
    + go.tag.db = tie_count

  - forfeitCount: int32
    + go.field.name = ForfeitCount
    + go.tag.db = forfeit_count

  - abandonCount: int32
    + go.field.name = AbandonCount
    + go.tag.db = abandon_count

  - winRatio: float32
    + go.field.name = WinRatio
    + go.tag.db = win_ratio

  - gamesPlayed: int32
    + go.field.name = GamesPlayed
    + go.tag.db = games_played
  
  - experience?: uint64
    + go.tag.db = -

  - score?: int32
    + go.tag.db = score,omitempty
    + go.field.name = Score

  - createdAt: timestamp
    + go.tag.db = created_at,omitempty
    + go.field.name = CreatedAt
    + go.field.type = *time.Time
  
  - updateAt: timestamp
    + go.tag.db = updated_at,omitempty
    + go.field.name = UpdatedAt
    + go.field.type = *time.Time
    + json = -

  - rank?: uint32
    + go.tag.db = rank,omitempty

  - rankProgress?: float32
    + go.tag.db = -

  - playerRank: PlayerRank
    + go.tag.db = player_rank,omitempty
    + go.field.type = PlayerRank

  - playerRankStage: PlayerRankStage
    + go.tag.db = player_rank_stage
    + go.field.type = PlayerRankStage

  - playerRankState: string
    + go.tag.db = player_rank_state
    + go.field.type = RankState
    + json = -
  
  - internalPlayerRankState?: string
    + go.tag.db = -
    + go.field.type = RankState
    + json = playerRankState,omitempty
  
  - winStreak: uint32
    + go.tag.db = win_streak

  - lossStreak: uint32
    + go.tag.db = loss_streak

  - season?: uint16
    + go.tag.db = season

  - status: AccountStatus
    + go.tag.db = status
    + go.field.type = AccountStatus
    + json = -

  - cursor: string
    + go.tag.db = cursor,omitempty
    + json = -

message SetInvitedByRequest
  - address: string
    + go.tag.db = -
    + go.field.type = Hash

  - invitedBy: string
    + go.tag.db = invited_by
    + go.field.type = Hash

message GMAccount
  - account: Account

  - conquestsUnlocked: bool

  - accountActions: []AccountAction

  - ipHistory: []IPAddressHistory

message TutorialProgress
  - accountID: uint64
    + go.tag.db = account_id
    + go.field.name = AccountID
    + go.field.type = AccountID
    + json = -
  
  - level: TutorialLevel
    + go.tag.db = level
    + go.field.type = TutorialLevel

  - completed: bool
    + go.tag.db = completed

enum TutorialLevel: uint16
  - UNKNOWN
  - LEVEL_1
  - LEVEL_2
  - LEVEL_3
  - LEVEL_4

enum PlayerRank: uint16
  - UNKNOWN
  - UNRANKED
  - WANDERER
  - TRAINEE
  - APPRENTICE
  - EXPERT
  - MASTER
  - GRANDWEAVER

enum PlayerRankStage: uint8
  - STAGE_NONE
  - STAGE_I
  - STAGE_II
  - STAGE_III

enum CookiePolicyOption: uint16
  - AUTHENTICATION
  - MARKETPLACE
  - GEO_BLOCKING
  - PRODUCT_ANALYTICS

enum ContractType: uint
  - UNKNOWN
  - SKYWEAVER_ASSETS


enum ItemType: uint
  - UNKNOWN            = 0

  # Currency, range 100-199
  - USDC               = 100

  # OpenSky base (non-tradeable) assets, range 300-399
  - SW_BASE_CARDS      = 300
  - SW_SKYPASS         = 301
  - SW_TITLES          = 302
  - SW_STICKER_POINTS  = 303
  - SW_XP              = 304

  # OpenSky blockchain assets, range 400-499
  - SW_SILVER_DUST     = 400
  - SW_SILVER_CARDS    = 401
  - SW_GOLD_CARDS      = 402
  - SW_CONQUEST_TICKET = 403
  - SW_CRYSTALS        = 404
  - SW_STICKERS        = 405
  - SW_HERO_SKINS      = 406
  - SW_CARD_BACKS      = 407

  # OpenSky base (non-tradeable) heroes
  - SW_HERO            = 500


message Item
  - id: uint64
    + go.tag.db = id,omitempty
    + go.field.name = ID

  - accountID: uint64
    + go.tag.db = account_id
    + go.field.name = AccountID
    + go.field.type = AccountID
    + json = -

  # account holder of the token, if accountAddress is empty the item balance represents
  # the total supply of that token id
  - accountAddress?: string
    + go.tag.db = account_address
    + go.field.type = Hash
    + json = -

  # token contract address
  - contractAddress?: string
    + go.tag.db = contract_address,omitempty
    + go.field.type = Hash

  - itemType: ItemType
    + go.tag.db = item_type,omitempty
    + go.field.type = ItemType

  - tokenID: uint64
    + go.tag.db = token_id

  - balance: string
    + go.tag.db = balance
    + go.field.type = prototyp.BigInt

  - lastUpdateID: uint64
    + go.tag.db = last_update_id

  - updatedAt?: timestamp
    + go.tag.db = updated_at,omitempty

  - createdAt?: timestamp
    + go.tag.db = created_at,omitempty

  - isNew?: bool
    + go.tag.db = is_new


message ItemSummary
  - id: uint64
    + go.tag.db = id,omitempty
    + go.field.name = ID

  - accountID: uint64
    + go.tag.db = account_id
    + go.field.name = AccountID
    + go.field.type = AccountID
    + json = -

  - itemType: ItemType
    + go.tag.db = item_type,omitempty
    + go.field.type = ItemType

  - totalBalance: string
    + go.tag.db = total_balance
    + go.field.type = prototyp.BigInt

  - updatedAt?: timestamp
    + go.tag.db = updated_at,omitempty

  - createdAt?: timestamp
    + go.tag.db = created_at,omitempty

message ItemSupply
  - itemID: uint64
  - itemType: ItemType
    + go.field.type = ItemType
  - totalBalance: string
    + go.field.type = prototyp.BigInt

enum FeedEventType: uint16
  - LEVELUP
  - MATCH
  - REWARD
  - TRADE
  - RANKUP
  - LEADERBOARD_REWARD
  - HERO_UNLOCK
  - IAP_CONQUEST_MINTING
  - DELAYED_REWARD
  - DELAYED_REWARD_MINTED
  - STARTED_DECK_UNLOCK
  - CONQUEST_V2_REWARD

enum Hero: uint16
  - UNKNOWN
  - ADA
  - SAMYA
  - FOX
  - LOTUS
  - TITUS
  - IRIS
  - BOURAN
  - HORIK
  - ZOEY
  - AXEL
  - ARI
  - MIRA
  - MAI
  - BANJO
  - SITTI

message GetFeedRequest
  - accountAddress: string
    + go.field.name = AccountAddress
    + go.field.type = Hash

  - types?: []FeedEventType
    + go.field.type = []FeedEventType

message FeedEvent
  - id: int64
    + go.tag.db = id,omitempty
    + go.field.name = ID

  - accountID: uint64
    + go.tag.db = account_id
    + go.field.name = AccountID
    + go.field.type = AccountID
    + json = -

  - type: FeedEventType
    + go.tag.db = event_type
    + go.field.type = FeedEventType

  - createdAt: timestamp
    + go.tag.db = created_at,omitempty
    + go.field.name = CreatedAt
    + go.field.type = *time.Time

  - matchId?: uint64
    + go.tag.db = match_id,omitempty
    + go.field.name = MatchID
    + json = -

  - match: Match
    + go.tag.db = -

  - level?: uint16
    + go.tag.db = level,omitempty

  - playerRank?: PlayerRank
    + go.tag.db = player_rank,omitempty

  - playerRankStage?: PlayerRankStage
    + go.tag.db = player_rank_stage,omitempty

  - season?: uint16
    + go.tag.db = season

  - tokenIds?: []uint64
    + go.tag.db = token_ids,omitempty
    + go.field.name = TokenIDs
    + go.field.type = U64JSONBArray

  - cards: []Card
    + go.tag.db = -

  - heroes: []Hero
    + go.field.type = []Hero
    + go.tag.db = -

  - gameMode?: GameMode
    + go.tag.db = game_mode

  - leaderboardRank?: int
    + go.tag.db = leaderboard_rank

  - conquestV2Reward?: float32
    + go.tag.db = conquest_v2_reward

  - conquestV2TreasureLevel?: uint16
    + go.tag.db = conquest_v2_treasure_level

  - stickerPoints?: uint16
    + go.tag.db = sticker_points,omitempty

  - cursor: string
    + go.tag.db = cursor,omitempty
    + json = -

enum DeckClass: uint16
  - UNKNOWN_CLASS

  - STR  # Strength
  - HRT  # Hearth
  - AGY  # Agility
  - INT  # Intellect
  - WIS  # Wisdom

  - STH  # Strength/Heart
  - STA  # Strength/Agility
  - STI  # Strength/Intellect
  - STW  # Strength/Wisdom

  - HRA  # Heart/Agility
  - HRI  # Heart/Intellect
  - HRW  # Heart/Wisdom

  - AGI  # Agility/Intellect
  - AGW  # Agility/Wisdom

  - INW  # Intellect/Wisdom

enum CardType: uint32
  - UNIT
  - SPELL

enum CardKeyword: uint32
  - ARMOR
  - STEALTH
  - GUARD
  - BANNER
  - WITHER
  - DEATH

enum CardElement: uint16
  - WATER
  - FIRE
  - EARTH
  - AIR
  - MIND
  - METAL
  - LIGHT
  - DARK

enum CardStatus: uint16
  - PLAY
  - BLOCKED
  - CODE

enum CardClass: uint16
  - STR  # Strength
  - HRT  # Hearth
  - AGY  # Agility
  - INT  # Intellect
  - WIS  # Wisdom
  - TOK  # Token


message CardImageURL
  - small: string
  - medium: string
  - large: string

enum CardSet: uint16
  - UNKNOWN
  - CORE_SET
  - CORE_EXPANSION
  - CLASH_OF_INVENTORS
  - HEXBOUND_INVASION
  - STARTER_EXPANSION

message Card
  - id: uint64
    + go.tag.db = id
    + go.field.name = ID

  - name: string
    + go.tag.db = name

  - description: string
    + go.tag.db = description

  - asset: string
    + go.tag.db = asset

  - class: CardClass
    + go.tag.db = class
    + go.field.type = CardClass

  - element: CardElement
    + go.tag.db = element
    + go.field.type = CardElement

  - type: CardType
    + go.tag.db = type
    + go.field.type = CardType

  - manaCost: int32
    + go.tag.db = mana_cost

  - power: uint32
    + go.tag.db = power

  - health: uint32
    + go.tag.db = health

  - attachedSpellID?: uint64
    + go.tag.db = attached_spell_id

  - keywords: []string
    + go.tag.db = keywords

  - status: CardStatus
    + go.tag.db = status
    + go.field.type = CardStatus

  - set: CardSet
    + go.tag.db = set
    + go.field.type = CardSet
    + json = set

  - attributes?: map<string,any>
    + json = -
    + go.field.type = interface{}

  - imageURL: CardImageURL
    + go.tag.db = -

  - itemType: ItemType
    + go.field.type = ItemType
    + go.tag.db = -

  - isNew?: bool
    + go.tag.db = -

  - silverCardTokenId?: uint64
    + go.field.name = SilverCardTokenID
    + go.tag.db = -

  - goldCardTokenId?: uint64
    + go.field.name = GoldCardTokenID
    + go.tag.db = -

  - validFromSeason: uint16
    + json = -
    + go.tag.db = valid_from_season

message Sticker
  - id: uint64
    + go.tag.db = id,omitempty
    + go.field.name = ID

  - name: string
    + go.tag.db = -

  - requiredPoints: uint64
    + go.tag.db = required_points
    + go.field.name = RequiredPoints

  - asset: string
    + go.tag.db = -

  - tokenId: uint64
    + go.tag.db = token_id
    + go.field.name = TokenID

  - season: uint16
    + go.tag.db = season

message StickerOwnershipResponse
  - stickerBalances: map<uint64,BalanceTuple>

message LevelsPerSeason
  - accountID: uint64
    + go.tag.db = account_id
    + go.field.name = AccountID
    + go.field.type = AccountID
    + json = -
  - address: string
    + go.field.type = Hash
  - inviterID: uint64
    + go.tag.db = inviter_id
    + go.field.name = InviterID
    + go.field.type = AccountID
    + json = -
  - inviter_address: string
    + go.field.type = Hash
    + go.field.name = InviterAddress
  - season: uint16
    + go.tag.db = season,omitempty
  - levels: uint64
    + go.tag.db = levels,omitempty
  - pointsCarried: uint64
    + go.tag.db = points_carried,omitempty
    + go.field.name = PointsCarried
  - pointsSpent: uint64
    + go.tag.db = points_spent,omitempty
    + go.field.name = PointsSpent

message FriendPoints
  - account?: Account
    + go.tag.db = account,omitempty
  - season: uint16
    + go.tag.db = season
    + json = season
  - levels: uint64
    + go.tag.db = levels
    + json = levels
  - points: uint64
    + go.tag.db = points
    + json = points
  - pointsSpent: uint64
    + go.tag.db = points_spent
    + go.field.name = PointsSpent

message CardSearchCriteria
  - ids?: []uint64
    + go.field.name = IDs

  - cardClass?: []CardClass
    + go.field.name = CardClass
    + go.field.type = []CardClass

  - cardType?: CardType
    + go.field.name = CardType

  - cardElement?: []CardElement
    + go.field.name = CardElement
    + go.field.type = []CardElement

  - searchText?: string
    + go.field.name = SearchText

  - cardManaCost?: []string
    + go.field.name = CardManaCost

  - itemType?: ItemType
    + go.field.name = ItemType

  - ownedCards?: bool

  - accountAddress?: string
    + go.field.type = Hash

  - includeTokens?: bool


message GetCardsRequest
  - ids: []uint64
    + go.field.name = IDs

  - includeUserBalances: bool

  - accountAddress?: string
    + go.field.type = Hash


message SearchCardsRequest
  - criteria: CardSearchCriteria
  - includeUserBalances: bool
  - contractQuery: bool

message CardWithBalance
  - card: Card
    + go.tag.db = ,inline

  - balance: string
    + go.tag.db = -
    + go.field.type = prototyp.BigInt

  - balanceByType: map<string,BalanceTuple>
    + go.tag.db = -

  - createdAt: timestamp
    + go.field.name = CreatedAt
    + go.field.type = *time.Time

  - cursor: string
    + go.tag.db = cursor,omitempty
    + json = -


message BalanceTuple
  - balance: string
    + go.tag.db = -
    + go.field.type = prototyp.BigInt

  - isNew?: bool
    +go.tag.db = -

message CardOwnershipResponse
  - cardBalances: map<uint64,map<string,BalanceTuple>>

  - lockedCards: uint64
  - lockedCardsByClass: map<string,uint64>
  - lockedCardsByFrame: map<string,uint64>
  - lockedCardsByClassAndFrame: map<string,map<string,uint64>>

  - unlockedCards: uint64
  - unlockedCardsByClass: map<string,uint64>
  - unlockedCardsByFrame: map<string,uint64>
  - unlockedCardsByClassAndFrame: map<string,map<string,uint64>>

  - pendingCards: uint64
  - pendingCardsByClass: map<string,uint64>
  - pendingCardsByFrame: map<string,uint64>
  - pendingCardsByClassAndFrame: map<string,map<string,uint64>>

message PendingCardsResponse
  - cards: []Card
  - tokenIDs: []uint64
  - mintAt: timestamp

message GMPendingCardsReponse
  - account: Account
  - mintAt: timestamp
  - cardsWonLastDay: uint
  - cardsWonLastWeek: uint

message WeeklyGolds
  - startAt: timestamp
    + go.tag.db = start_at
    + go.field.name = StartAt

  - endAt: timestamp
    + go.tag.db = end_at
    + go.field.name = EndAt

  - tokenId: uint64
    + go.tag.db = token_id
    + go.field.name = TokenID

  - totalSupply: uint64
    + go.tag.db = -

#
# Decks
#

message Deck
  - uuid: string
    + go.tag.db = uuid,omitempty
    + go.field.name = UUID

  - accountID: uint64
    + go.tag.db = account_id
    + go.field.name = AccountID
    + go.field.type = AccountID
    + json = -

  - name: string
    + go.tag.db = name

  - class: DeckClass
    + go.tag.db = class
    + go.field.type = DeckClass

  - deckString: string
    + go.field.name = DeckString
    + go.tag.db = deck_string

  - cardIds: []uint64
    + go.tag.db = card_ids,omitempty
    + go.field.name = CardIDs
    + go.field.type = U64JSONBArray

  - art: string
    + go.tag.db = art

  - createdAt: timestamp
    + go.tag.db = created_at,omitempty
    + go.field.name = CreatedAt
    + go.field.type = *time.Time

  - updatedAt: timestamp
    + go.tag.db = updated_at,omitempty
    + go.field.name = UpdatedAt
    + go.field.type = *time.Time

  - isFavorite: bool
    + go.tag.db = -
    + go.field.name = IsFavorite

  - favoritedAt: timestamp
    + go.tag.db = favorited_at
    + go.field.name = FavoritedAt
    + go.field.type = *time.Time

  - cursor: string
    + go.tag.db = cursor,omitempty
    + json = -

  - deckType: DeckType
    + go.tag.db = deck_type,omitempty
