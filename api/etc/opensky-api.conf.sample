# wallet is used to mint rewards, etc..
[wallet]
    private_mnemonic = "test test test test test test test test test test test junk"


##
## OpenSky game settings
##

[opensky]
  image_base_url  = "http://localhost:4001/"
  experience_multiplier = 1.0
  reward_multiplier = 1

  [opensky.worker]
    listen = "0.0.0.0:1338"
    item_balance_sync = true
    rewards_minting = false
    conquest_minting = true # NOTE: not in use at the moment

  [opensky.leaderboard_rewards]
    # aka, every Monday at 5pm EST
    weekday = 5 # Sunday = 0
    time = "15:10" # UTC, HH:MM
    rewards_excluded_card_sets = "HEXBOUND_INVASION"

  [opensky.gamemaster]
    allow_change_rank_elo = true

  [opensky.conquest_v2]
    max_pool_ceiling = 5000
    pool_ceiling = 2500
    pool_floor = 100
    top_weight_unit_price = 1.0
    bottom_weight_unit_price = 0.9
    rewards_schedule_weekday = 1 # Sunday = 0
    rewards_schedule_time = "01:00" # UTC, HH:MM
    rewards_send_weekday = 2 # Sunday = 0
    rewards_send_time = "01:00" # UTC, HH:MM
    rewards_excluded_card_sets = "HEXBOUND_INVASION"
    rewards_weekly_exclusive_card_sets = "HEXBOUND_INVASION"

  [opensky.mobile-iap]
    enabled         = false
    google_key_data = '''{
      "type": "service_account",
      "project_id": "x",
      "private_key_id": "x"
      "etc..": "etc.."
    }'''

  [opensky.onchain_payment]
    enabled = true
    monitor_debug_logging = true
    monitor_polling_interval_millisecond = 500
    monitor_start_num_blocks_back = 1000
    subscribe_idle_timeout_seconds = 1

##
## Misc
##

[s3]
  access_key           = ""
  access_secret_key    = ""
  records_bucket       = "records-internal.skyweaver.net"
  prefix               = "local"


[telemetry]
  username = ""
  password = ""

